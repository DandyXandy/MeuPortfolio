# Necessário só para a seção "Solicitar Projeto" funcionar.
# Copie este arquivo para ".env" e preencha os valores (veja o README).

# Supabase (banco de dados) — pasta do projeto no Supabase > Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Resend (envio de e-mails) — dashboard do Resend > API Keys
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Dandy Abadie <onboarding@resend.dev>"

# Para onde vai o e-mail de notificação de cada novo pedido
NOTIFICATION_EMAIL="dandyabadie12@gmail.com"
